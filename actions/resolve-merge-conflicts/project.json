{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-resolve-merge-conflicts",
  "projectType": "application",
  "sourceRoot": "actions/resolve-merge-conflicts/src",
  "implicitDependencies": ["action-merge-conflict-resolution"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/resolve-merge-conflicts",
        "command": "tsc --noEmit --project tsconfig.json"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "options": {
        "main": "actions/resolve-merge-conflicts/src/main.ts",
        "tsConfig": "actions/resolve-merge-conflicts/tsconfig.json",
        "outputPath": "actions/resolve-merge-conflicts/dist",
        "outputFileName": "main.js",
        "bundle": true,
        "thirdParty": true,
        "format": ["esm"],
        "platform": "node",
        "target": "node24",
        "outputHashing": "none",
        "minify": true,
        "sourcemap": false,
        "declaration": false,
        "skipTypeCheck": true
      },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"]
    }
  }
}
