{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-resolve-merge-conflicts",
  "projectType": "application",
  "sourceRoot": "actions/resolve-merge-conflicts/src",
  "implicitDependencies": ["action-merge-conflict-resolution"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/resolve-merge-conflicts",
        "command": "tsc --noEmit --project tsconfig.json"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/resolve-merge-conflicts",
        "command": "node ../../scripts/build-action.mjs"
      },
      "cache": true,
      "inputs": ["bundleProduction", "^bundleProduction", "bundleGlobals"],
      "outputs": ["{projectRoot}/dist/main.js"],
      "dependsOn": ["typecheck", "^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "command": "pnpm exec vitest run actions/resolve-merge-conflicts/src && node actions/resolve-merge-conflicts/tests/entrypoint-smoke.mjs"
      }
    }
  }
}
