{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-resolve-merge-conflicts",
  "projectType": "application",
  "sourceRoot": "actions/resolve-merge-conflicts/src",
  "implicitDependencies": ["action-merge-conflict-resolution"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/resolve-merge-conflicts",
        "command": "tsc --noEmit --project tsconfig.json"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "options": {
        "main": "actions/resolve-merge-conflicts/src/main.ts",
        "tsConfig": "actions/resolve-merge-conflicts/tsconfig.json",
        "outputPath": "actions/resolve-merge-conflicts/dist",
        "outputFileName": "main.js",
        "bundle": true,
        "thirdParty": true,
        "format": ["esm"],
        "platform": "node",
        "target": "node24",
        "outputHashing": "none",
        "minify": true,
        "sourcemap": false,
        "declaration": false,
        "skipTypeCheck": true
      },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "command": "pnpm exec vitest run actions/resolve-merge-conflicts/src/lazy-agent-port.spec.ts && node actions/resolve-merge-conflicts/tests/entrypoint-smoke.mjs"
      }
    },
    "bundle-drift": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "actions/resolve-merge-conflicts",
        "command": "tmpdir=$(mktemp -d) && trap 'rm -rf \"$tmpdir\"' EXIT && pnpm exec esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --tsconfig=tsconfig.json --outfile=\"$tmpdir/main.js\" --minify && cmp -s dist/main.js \"$tmpdir/main.js\""
      }
    }
  }
}
