{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-opencode-server",
  "projectType": "application",
  "sourceRoot": "actions/opencode-server/src",
  "implicitDependencies": ["action-service-lifecycle"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/opencode-server",
        "command": "tsc --noEmit --project tsconfig.json"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/opencode-server",
        "command": "pnpm exec esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.js --minify && pnpm exec esbuild src/post.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/post.js --minify"
      },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "command": "node --check actions/opencode-server/process-anchor.js && git diff --check"
      }
    },
    "bundle-drift": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "command": "git diff --exit-code -- actions/opencode-server/dist/"
      }
    }
  }
}
