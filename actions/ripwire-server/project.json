{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-ripwire-server",
  "projectType": "application",
  "sourceRoot": "actions/ripwire-server/src",
  "implicitDependencies": ["action-service-lifecycle"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/ripwire-server",
        "command": "tsc --noEmit --project tsconfig.json"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/ripwire-server",
        "command": "node ../../scripts/build-action.mjs"
      },
      "cache": true,
      "inputs": ["bundleProduction", "^bundleProduction", "bundleGlobals"],
      "outputs": [
        "{projectRoot}/dist/main.js",
        "{projectRoot}/dist/post.js",
        "{projectRoot}/dist/process-anchor.js"
      ],
      "dependsOn": ["typecheck", "^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "actions/ripwire-server",
        "command": "node --check dist/process-anchor.js && pnpm exec vitest run src"
      }
    }
  }
}
