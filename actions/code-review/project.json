{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-code-review",
  "projectType": "application",
  "sourceRoot": "actions/code-review/src",
  "implicitDependencies": ["action-code-review-library"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/code-review",
        "command": "tsc --noEmit --project tsconfig.json"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/code-review",
        "command": "node ../../scripts/build-action.mjs"
      },
      "cache": true,
      "inputs": ["bundleProduction", "^bundleProduction", "bundleGlobals"],
      "outputs": ["{projectRoot}/dist/main.js", "{projectRoot}/dist/post.js"],
      "dependsOn": ["typecheck", "^build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "command": "node actions/code-review/tests/entrypoint-smoke.mjs && pnpm exec vitest run actions/code-review/src"
      }
    }
  }
}
