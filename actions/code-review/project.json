{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-code-review",
  "projectType": "application",
  "sourceRoot": "actions/code-review/src",
  "implicitDependencies": ["action-code-review-library"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/code-review",
        "command": "tsc --noEmit --project tsconfig.json"
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "actions/code-review",
        "command": "pnpm exec esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --tsconfig=tsconfig.json --outfile=dist/main.js --minify && pnpm exec esbuild src/post.ts --bundle --platform=node --target=node24 --format=esm --tsconfig=tsconfig.json --outfile=dist/post.js --minify"
      },
      "cache": true,
      "inputs": ["bundleProduction", "^bundleProduction", "bundleGlobals"],
      "outputs": ["{projectRoot}/dist/main.js", "{projectRoot}/dist/post.js"],
      "dependsOn": ["typecheck", "^build"]
    },
    "verify-git-host": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["bundleProduction", "^bundleProduction", "bundleGlobals"],
      "outputs": ["{projectRoot}/dist/git-host-smoke.mjs"],
      "options": {
        "cwd": ".",
        "command": "pnpm exec esbuild libs/action-code-review/src/review-git-host.linux.test-support.ts --bundle --platform=node --target=node24 --format=esm --outfile=actions/code-review/dist/git-host-smoke.mjs && node actions/code-review/tests/git-host-smoke.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": ".",
        "command": "node actions/code-review/tests/entrypoint-smoke.mjs && pnpm exec vitest run actions/code-review/src/failure-diagnostics.spec.ts actions/code-review/src/main.spec.ts"
      }
    }
  }
}
