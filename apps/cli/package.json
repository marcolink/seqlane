{
  "name": "seqlane",
  "version": "0.0.1",
  "description": "Run typed Seqlane workflows from files or installed packages.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seqlane": "bin/run.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js",
      "default": "./dist/runner.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "release:npm"
    ]
  },
  "dependencies": {
    "mastra": "1.27.3",
    "@seqlane/core": "0.0.1",
    "@seqlane/agent-adapter": "0.0.1",
    "@seqlane/codex-adapter": "0.0.1",
    "@seqlane/opencode-adapter": "0.0.1",
    "@seqlane/protocol": "0.0.1",
    "@seqlane/tui": "0.0.1",
    "@seqlane/runtime": "0.0.1",
    "@oclif/core": "4.13.5",
    "get-tsconfig": "4.14.3",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@seqlane/fixtures": "workspace:*"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.tsbuildinfo",
    "oclif.config.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "apps/cli"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
