{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs-site",
  "projectType": "application",
  "sourceRoot": "apps/docs",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/docs",
        "command": "pnpm exec vitepress build ."
      },
      "outputs": ["{projectRoot}/.vitepress/dist"]
    }
  }
}
