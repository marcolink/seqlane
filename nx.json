{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "cli": {
    "packageManager": "pnpm"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "bundleProduction": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "bundleGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/*.yml"]
  },
  "targetDefaults": {
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e 'const value = process.env.NX_DRY_RUN; if (value !== \"true\" && value !== \"false\") { console.error(\"NX_DRY_RUN must be explicitly set to true or false\"); process.exit(1); }' && pnpm --dir ./{projectRoot} pack --out \"$PWD/.nx/release-packages/{projectName}.tgz\" && package_spec=$(node -p 'const manifest = require(\"./{projectRoot}/package.json\"); `${manifest.name}@${manifest.version}`') && if [ \"$NX_DRY_RUN\" = \"false\" ] && npm view \"$package_spec\" version --json >/dev/null 2>&1; then echo \"Skipping already published $package_spec\"; else npm publish \"$PWD/.nx/release-packages/{projectName}.tgz\" --json --access public --dry-run=\"$NX_DRY_RUN\"; fi",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "release": {
    "projects": ["tag:release:npm"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}",
      "requireSemver": true,
      "strictPreid": true
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": true,
      "preserveLocalDependencyProtocols": true,
      "versionPrefix": ""
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": false
    },
    "git": {
      "commit": false,
      "tag": true,
      "push": true
    }
  },
  "analytics": false
}
