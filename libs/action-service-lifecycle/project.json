{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-service-lifecycle",
  "projectType": "library",
  "sourceRoot": "libs/action-service-lifecycle/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/action-service-lifecycle",
        "command": "tsc --build tsconfig.json && pnpm exec esbuild src/process-anchor.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/process-anchor.js --minify"
      },
      "cache": true,
      "inputs": ["bundleProduction", "^bundleProduction", "bundleGlobals"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "libs/action-service-lifecycle",
        "command": "vitest run"
      }
    }
  }
}
