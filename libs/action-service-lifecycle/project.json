{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "action-service-lifecycle",
  "projectType": "library",
  "sourceRoot": "libs/action-service-lifecycle/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/action-service-lifecycle",
        "command": "tsc --build tsconfig.json"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/action-service-lifecycle",
        "command": "vitest run"
      }
    }
  }
}
