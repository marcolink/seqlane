{
  "name": "@seqlane/opencode-v2-adapter",
  "version": "0.0.0",
  "description": "OpenCode V2 adapter for Seqlane.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "release:npm",
      "adapter:concrete"
    ]
  },
  "dependencies": {
    "@opencode/client": "2.1.2",
    "@seqlane/agent-adapter": "workspace:*",
    "@seqlane/core": "workspace:*",
    "zod": "4.6.6"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "tested-versions.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/opencode-v2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
