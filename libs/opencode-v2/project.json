{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "opencode-v2",
  "projectType": "library",
  "sourceRoot": "libs/opencode-v2/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/opencode-v2",
        "command": "tsc --build tsconfig.json"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "libs/opencode-v2", "command": "vitest run" }
    }
  }
}
