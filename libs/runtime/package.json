{
  "name": "@seqlane/runtime",
  "version": "0.0.0",
  "description": "Effect runtime and hosted operations for Seqlane workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner/main.d.ts",
      "import": "./dist/runner/main.js",
      "default": "./dist/runner/main.js"
    },
    "./workflow": {
      "types": "./dist/runner/workflow/index.d.ts",
      "import": "./dist/runner/workflow/index.js",
      "default": "./dist/runner/workflow/index.js"
    },
    "./operational-host": {
      "types": "./dist/operational-host.d.ts",
      "import": "./dist/operational-host.js",
      "default": "./dist/operational-host.js"
    },
    "./private/telemetry": {
      "types": "./dist/private/telemetry/index.d.ts",
      "import": "./dist/private/telemetry/index.js",
      "default": "./dist/private/telemetry/index.js"
    },
    "./private/owned-process": {
      "types": "./dist/private/owned-process/index.d.ts",
      "import": "./dist/private/owned-process/index.js",
      "default": "./dist/private/owned-process/index.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "release:npm",
      "boundary:generic-runtime"
    ]
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/sql-sqlite-node": "4.0.5",
    "@seqlane/agent-adapter": "workspace:*",
    "@seqlane/core": "workspace:*",
    "@seqlane/protocol": "workspace:*",
    "effect": "4.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@seqlane/fixtures": "workspace:*"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/**/*test-support*",
    "!dist/test-fixtures/**",
    "!dist/**/*-fixture.*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/runtime"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
