{
  "name": "@seqlane/runtime",
  "version": "0.0.1",
  "description": "Mastra runtime integration for Seqlane workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner/main.d.ts",
      "import": "./dist/runner/main.js",
      "default": "./dist/runner/main.js"
    },
    "./workflow": {
      "types": "./dist/runner/workflow/index.d.ts",
      "import": "./dist/runner/workflow/index.js",
      "default": "./dist/runner/workflow/index.js"
    },
    "./operational-host": {
      "types": "./dist/operational-host.d.ts",
      "import": "./dist/operational-host.js",
      "default": "./dist/operational-host.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "release:npm",
      "boundary:generic-runtime"
    ]
  },
  "dependencies": {
    "@seqlane/agent-adapter": "0.0.1",
    "@mastra/core": "1.64.0",
    "@mastra/hono": "1.7.6",
    "@mastra/libsql": "1.22.3",
    "@mastra/mcp": "1.15.0",
    "@mastra/observability": "1.17.4",
    "@mastra/server": "1.64.0",
    "@hono/node-server": "2.1.1",
    "@seqlane/core": "0.0.1",
    "@seqlane/protocol": "0.0.1",
    "hono": "4.13.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@seqlane/fixtures": "workspace:*"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/runtime"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
