{
  "name": "@seqlane/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner/main.d.ts",
      "import": "./dist/runner/main.js",
      "default": "./dist/runner/main.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private"
    ]
  },
  "dependencies": {
    "@mastra/core": "1.64.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@seqlane/core": "workspace:*",
    "@seqlane/events": "workspace:*",
    "@seqlane/opencode": "workspace:*",
    "effect": "3.22.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@seqlane/fixtures": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/seqlane-runtime"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "npm": "use pnpm instead - see README.md",
    "yarn": "use pnpm instead - see README.md",
    "pnpm": ">=10.33.0"
  }
}
