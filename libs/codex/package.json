{
  "name": "@seqlane/codex-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "adapter:concrete"
    ]
  },
  "dependencies": {
    "@seqlane/agent-adapter": "workspace:*",
    "@seqlane/core": "workspace:*",
    "zod": "4.5.4"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/codex"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "npm": "use pnpm instead - see README.md",
    "yarn": "use pnpm instead - see README.md",
    "pnpm": ">=10.33.0"
  }
}
