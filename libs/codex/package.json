{
  "name": "@seqlane/codex-adapter",
  "version": "0.0.0",
  "description": "Codex app-server adapter for Seqlane.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "release:npm",
      "adapter:concrete"
    ]
  },
  "dependencies": {
    "@seqlane/agent-adapter": "workspace:*",
    "@seqlane/core": "workspace:*",
    "effect": "4.0.5",
    "zod": "4.6.6"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "tested-versions.json",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/**/*test-support*",
    "!dist/test-fixtures/**",
    "!dist/**/*-fixture.*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/codex"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
