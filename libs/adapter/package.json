{
  "name": "@seqlane/agent-adapter",
  "version": "0.0.1",
  "description": "Internal agent-adapter contracts for Seqlane runtimes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "tags": [
      "type:lib",
      "scope:private",
      "release:npm"
    ]
  },
  "dependencies": {
    "@seqlane/core": "0.0.1",
    "@seqlane/protocol": "0.0.1",
    "zod": "4.5.4"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcolink/seqlane.git",
    "directory": "libs/adapter"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
